{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "kernel/*": ["kernel/*"]
    },
    "types": ["chrome", "svelte", "vite/client"],
    "ignoreDeprecations": "6.0"
  },
  "include": ["kernel/**/*.ts", "background/**/*.ts", "bridge/**/*.ts", "sidepanel/**/*.ts", "sidepanel/**/*.svelte", "global.d.ts"]
}