{
  "manifest_version": 3,
  "name": "Web Agent Client",
  "version": "0.5.1",
  "description": "AI Agent Runtime Environment for Web - Provides execution environment and capabilities for AI agents",
  
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "sidePanel",
    "userScripts"
  ],
  
  "web_accessible_resources": [
    {
      "resources": ["kernel/*", "kernel/models/*", "kernel/services/*", "kernel/services/ProviderAPIServices/*", "kernel/tools/*", "sidepanel/*", "sidepanel/js/*", "sidepanel/theme/*"],
      "matches": ["<all_urls>"]
    }
  ],
  
  "host_permissions": [
    "<all_urls>"
  ],
  
  "background": {
    "service_worker": "sidepanel/js/background.js",
    "type": "module"
  },
  
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  
  "action": {
    "default_title": "Open Web Agent",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Open Side Panel"
    }
  },
  
  "icons": {
    "16": "assets/icons/icon16.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  }
}
